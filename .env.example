# Telegram (@BotFather)
TELEGRAM_BOT_TOKEN=
OPERATOR_CHAT_ID=
ALLOWED_CHAT_IDS=
ADMIN_USER_IDS=

# Admin API + web UI http://localhost:8088/
# Note: на сервере astera.laser.ru порт 8080 занят (ahttpd), используем 8088.
ADMIN_API_HOST=0.0.0.0
ADMIN_API_PORT=8088
ADMIN_API_KEY=change-me

# Retrieval
RETRIEVAL_HIGH_TH=0.52
RETRIEVAL_MID_TH=0.42
RETRIEVAL_LEXICAL_AUTO=0.38
RETRIEVAL_TOP_K=3
USE_EMBEDDING_CACHE=1
# EMBEDDING_MODEL=sentence-transformers/paraphrase-multilingual-MiniLM-L12-v2

# Гибридный поиск (BM25 + sentence-embeddings). USE_HYBRID_RETRIEVAL=0 → только эмбеддинги
USE_HYBRID_RETRIEVAL=1
BM25_WEIGHT=0.30

# Ollama RAG (обязательный компонент проекта)
# Production: внешний сервер Ollama с GPU
# Локальная разработка: http://localhost:11434 (поднять через `docker compose --profile local-ollama up -d`)
OLLAMA_BASE_URL=http://smarttherm.ru:11434
OLLAMA_MODEL=qwen3:14b
OLLAMA_TIMEOUT=120
OLLAMA_TEMPERATURE=0.05
OLLAMA_NUM_CTX=8192
OLLAMA_NUM_PREDICT=700
RAG_TOP_CHUNKS=3
USE_RAG_FOR_AUTO=1
USE_RAG_FOR_CLARIFY=0
USE_RAG_FOR_ESCALATE=0
RAG_FALLBACK_TO_FAQ=1
# Ollama спрашивает YES/NO: подходит ли FAQ на вопрос (рекомендуется)
USE_RELEVANCE_JUDGE=1
RAG_SHOW_FOOTER=0

# Уровни ответа:
# Tier 2 — карточки из чата (from_chat) через LLM с пометкой
# Tier 3 — общий ответ LLM по теме SmartTherm + дисклеймер
USE_CHAT_TIER=1
USE_GENERAL_LLM_FALLBACK=1
CHAT_TIER_MIN_SIM=0.45

# Bot
LOG_ALL_MESSAGES=1
ESCALATE_ON_NOT_HELPFUL=1

# Database (default sqlite)
# DATABASE_URL=postgresql://user:pass@db:5432/smarttherm
